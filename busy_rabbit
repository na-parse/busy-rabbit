#!/usr/bin/env python3
'''busy-rabbit control shim.

A single entry point for operating the app: starting the server, initialising
and inspecting the SQLite database, checking configuration, and tailing logs.
Run ``./busy_rabbit --help`` (or ``python3 busy_rabbit --help``) for the full
command list.

This file only bootstraps ``sys.path`` so the bare script can find the
``br_server`` package (including when invoked through a symlink on ``PATH``);
all command logic lives in :mod:`br_server.cli`.
'''

import sys
from pathlib import Path

# Make the package importable when run as a bare script. ``.resolve()`` follows
# symlinks so a launcher symlinked onto PATH still points at the real repo root.
REPO_ROOT = Path(__file__).resolve().parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))


if __name__ == '__main__':
    # Deferred until after the sys.path bootstrap above.
    from br_server.cli import main

    raise SystemExit(main())
